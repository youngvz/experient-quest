# Copy to `.env.local` for local dev (git-ignored by Vite's defaults).
# Vite inlines any `VITE_*` var into the build.

# WebSocket URL the multiplayer client connects to.
#   Local dev:       ws://localhost:8080
#   IP-only phase:   ws://<elastic-ip>:8080
#   With TLS + DNS:  wss://mmo.yourdomain.com/game
VITE_MMO_URL=ws://localhost:8080
