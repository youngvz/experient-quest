# TLS-terminating reverse proxy for the multiplayer server.
#
# MMO_HOSTNAME is set at container start (docker-compose.yml) from the
# host env. Set it to whatever DNS name resolves to this box:
#   - Production w/ EIP + sslip.io:  MMO_HOSTNAME=100-50-132-39.sslip.io
#   - Local dev:                     MMO_HOSTNAME=localhost
#   - Custom domain (later):         MMO_HOSTNAME=mmo.yourdomain.com
#
# Caddy auto-issues a Let's Encrypt cert on first HTTPS request from
# that hostname. The cert lives in the caddy_data volume and survives
# container restarts; only a fresh volume triggers re-issuance.

{$MMO_HOSTNAME:localhost} {
	# WebSocket endpoint. `handle` lets us keep the block extensible
	# (add /health, static file serving, etc.) without disturbing the
	# WSS path.
	handle /game {
		reverse_proxy game:8080
	}

	handle /health {
		respond "ok" 200
	}

	# Compress non-WS responses. WS frames are excluded automatically.
	encode zstd gzip

	# Modest logging — the game server does the interesting logging.
	log {
		output stdout
		format console
	}
}
